[Unit]
Description=Hook Studio image and video hook service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=donxu
Group=donxu
WorkingDirectory=/opt/hook-studio/current
EnvironmentFile=/etc/hook-studio/hook-studio.env
ExecStart=/opt/hook-studio/current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8011 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hook-studio

[Install]
WantedBy=multi-user.target
